{
  "name": "rivercitymd",
  "version": "0.1.3",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:native": "turbo run dev --filter=native",
    "dev:backend": "turbo run dev --filter=@rivercitymd/backend",
    "build": "turbo run build",
    "check": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "@rivercitymd/config": "workspace:*",
    "next": "16.1.1",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3"
  }
}
